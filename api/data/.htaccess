# Blocca qualsiasi accesso diretto via browser ai backup dati salvati
# qui dentro. Solo sync.php (che gira lato server, non tramite HTTP) puo'
# leggerli/scriverli. Funziona sia con Apache 2.4 che con versioni piu'
# vecchie.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
